// مخطط قاعدة البيانات — المرحلة 1 (المستخدم، الهيكل، السعة، التدقيق) + المرحلة 2 (المهام)
// بقية النماذج (الحالات القابلة للتخصيص، الانحراف…) تُضاف في مراحلها حسب PLAN.md القسم 5.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ceo
  generalAdminManager
  followUpOfficer
  adminManager
  supervisor
  employee
}

enum AuthSource {
  local
  ldap
}

model User {
  id                 String     @id @default(uuid())
  name               String
  employeeNo         String     @unique
  email              String     @unique
  passwordHash       String? // فارغ إذا كان مصدر الهوية LDAP
  authSource         AuthSource @default(local)
  role               Role
  generalAdminId     String?
  administrationId   String?
  sectionId          String?
  isActive           Boolean    @default(true)
  failedLogins       Int        @default(0)
  lockedUntil        DateTime?
  passwordChangedAt  DateTime?
  // ── التقاط مبكّر لمحرك الانحراف (القسم 9.1) — حقول فقط، بلا حساب في المرحلة 1 ──
  dailyCapacityHours Float      @default(6)
  workingDays        Int[]      @default([0, 1, 2, 3, 4]) // 0=الأحد … 4=الخميس
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  generalAdmin   GeneralAdministration? @relation("GAMembers", fields: [generalAdminId], references: [id], onDelete: SetNull)
  administration Administration?        @relation("AdminMembers", fields: [administrationId], references: [id], onDelete: SetNull)
  section        Section?               @relation("SectionMembers", fields: [sectionId], references: [id], onDelete: SetNull)

  managedGeneralAdmins   GeneralAdministration[] @relation("GAManager")
  managedAdministrations Administration[]        @relation("AdminManager")
  supervisedSections     Section[]               @relation("SectionSupervisor")

  refreshTokens     RefreshToken[]
  passwordHistory   PasswordHistory[]
  leaves            Leave[]
  auditLogs         AuditLog[]
  // ── المرحلة 2 ──
  createdTasks      Task[]           @relation("TaskCreator")
  taskAssignments   TaskAssignment[]
  comments          Comment[]
  attachments       Attachment[]
  taskActivities    TaskActivity[]

  @@index([generalAdminId])
  @@index([administrationId])
  @@index([sectionId])
  @@index([role])
}

/// آخر كلمات المرور — لمنع إعادة الاستخدام (PASSWORD_POLICY.historySize)
model PasswordHistory {
  id        String   @id @default(uuid())
  userId    String
  hash      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// رموز التحديث الدوّارة — نخزّن تجزئة الرمز لا الرمز نفسه
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  ip        String?
  userAgent String?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model GeneralAdministration {
  id        String   @id @default(uuid())
  name      String   @unique
  managerId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  manager         User?            @relation("GAManager", fields: [managerId], references: [id], onDelete: SetNull)
  administrations Administration[]
  members         User[]           @relation("GAMembers")
}

model Administration {
  id             String   @id @default(uuid())
  generalAdminId String
  name           String
  managerId      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  generalAdmin GeneralAdministration @relation(fields: [generalAdminId], references: [id], onDelete: Restrict)
  manager      User?                 @relation("AdminManager", fields: [managerId], references: [id], onDelete: SetNull)
  sections     Section[]
  members      User[]                @relation("AdminMembers")
  sizePresets  SizePresetConfig[]

  @@unique([generalAdminId, name])
  @@index([generalAdminId])
}

model Section {
  id               String   @id @default(uuid())
  administrationId String
  name             String
  supervisorId     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  administration Administration @relation(fields: [administrationId], references: [id], onDelete: Restrict)
  supervisor     User?          @relation("SectionSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  members        User[]         @relation("SectionMembers")

  @@unique([administrationId, name])
  @@index([administrationId])
}

/// العطل الرسمية — تُستثنى من جدولة السعة (المرحلة 6)
model Holiday {
  id        String   @id @default(uuid())
  date      DateTime @unique @db.Date
  name      String
  createdAt DateTime @default(now())
}

/// إجازات الموظف — تُستثنى من سعته وحده (المرحلة 6)
model Leave {
  id        String   @id @default(uuid())
  userId    String
  startAt   DateTime @db.Date
  endAt     DateTime @db.Date
  reason    String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  meta      Json?
  ip        String?
  userAgent String?
  timestamp DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([timestamp])
  @@index([userId])
  @@index([entity, entityId])
}

// ═══════════════════════════ المرحلة 2 — المهام ═══════════════════════════

enum TaskCategory {
  routine
  adhoc
}

enum TaskPriority {
  low
  medium
  high
}

/// الفئة السلوكية للحالة (PLAN 9.أ) — المرحلة 3 تضيف TaskStatus القابلة للتخصيص وتربطها بهذه الفئة
enum TaskState {
  not_started
  in_progress
  done
}

enum SizePreset {
  daily
  weekly
  long
}

enum AssigneeType {
  user
  section
  administration
  generalAdmin
}

model Task {
  id             String       @id @default(uuid())
  /// رقم قصير متسلسل للعرض (#1048)
  seq            Int          @unique @default(autoincrement())
  title          String
  description    String?
  category       TaskCategory
  priority       TaskPriority @default(medium)
  state          TaskState    @default(not_started)
  dueDate        DateTime?    @db.Date
  // ── التقاط مبكّر لمحرك الانحراف (PLAN 9.1 و9.4) — حقول فقط، بلا حساب ──
  sizePreset     SizePreset?
  estimatedHours Float? // يُشتق من sizePreset عبر SizePresetConfig، ويمكن تجاوزه يدويًا
  startedAt      DateTime? // أول انتقال إلى in_progress
  completedAt    DateTime? // آخر انتقال إلى done
  /// المهام الفرعية ذاتية المرجع (مستوى واحد)
  parentTaskId   String?
  /// موقع المهمة في الشجرة (من موقع منشئها أو ما حدّده ضمن نطاقه) — أساس نطاق الرؤية
  generalAdminId   String?
  administrationId String?
  sectionId        String?
  createdById    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  createdBy   User             @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  parent      Task?            @relation("Subtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks    Task[]           @relation("Subtasks")
  assignments TaskAssignment[]
  comments    Comment[]
  attachments Attachment[]
  activities  TaskActivity[]

  @@index([parentTaskId])
  @@index([createdById])
  @@index([state])
  @@index([dueDate])
  @@index([generalAdminId])
  @@index([administrationId])
  @@index([sectionId])
}

/// الإسناد المتعدد متعدد الأنواع. موقع الجهة في الشجرة يُحفظ مع الإسناد ليُحسب نطاق الرؤية باستعلام واحد.
model TaskAssignment {
  id           String       @id @default(uuid())
  taskId       String
  assigneeType AssigneeType
  assigneeId   String
  generalAdminId   String?
  administrationId String?
  sectionId        String?
  userId           String?
  assignedById String?
  createdAt    DateTime     @default(now())

  task Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, assigneeType, assigneeId])
  @@index([userId])
  @@index([sectionId])
  @@index([administrationId])
  @@index([generalAdminId])
}

/// ترجمة الحجم إلى ساعات — افتراضي عام (administrationId = null) وقابل للضبط لكل إدارة
model SizePresetConfig {
  id               String     @id @default(uuid())
  administrationId String?
  size             SizePreset
  hours            Float
  updatedAt        DateTime   @updatedAt

  administration Administration? @relation(fields: [administrationId], references: [id], onDelete: Cascade)

  @@unique([administrationId, size])
}

model Comment {
  id        String   @id @default(uuid())
  taskId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
}

/// المرفقات: الملف خارج الجذر العام باسم عشوائي (storedName)، والاسم الأصلي للعرض فقط
model Attachment {
  id           String   @id @default(uuid())
  taskId       String
  uploadedById String
  fileName     String
  storedName   String   @unique
  mimeType     String
  size         Int
  createdAt    DateTime @default(now())

  task       Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy User @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([taskId])
}

/// سجل نشاط المهمة — كل تغيير (إنشاء/تعديل/حالة/إسناد/تعليق/مرفق)
model TaskActivity {
  id        String   @id @default(uuid())
  taskId    String
  actorId   String?
  type      String
  data      Json?
  createdAt DateTime @default(now())

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
}
