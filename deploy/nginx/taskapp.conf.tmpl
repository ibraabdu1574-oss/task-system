# قالب موقع nginx — يُطبَّق بـ: sudo task nginx
# البدائل: __DOMAIN__ · __WEB_PORT__ · __API_PORT__

limit_req_zone $binary_remote_addr zone=login:10m rate=5r/m;

# يرفض أي طلب لا يطلب النطاق (مثل الوصول بعنوان IP)
server {
    listen 443 ssl default_server;
    server_name _;
    include snippets/tls-params.conf;
    ssl_reject_handshake on;
}

server {
    listen 443 ssl;
    http2 on;
    server_name __DOMAIN__;

    ssl_certificate     /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    include snippets/tls-params.conf;

    add_header Strict-Transport-Security "max-age=86400" always;   # يوم واحد أثناء التطوير
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    modsecurity on;
    modsecurity_rules_file /etc/nginx/modsec/main.conf;

    client_max_body_size 25m;     # المرفقات

    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade           $http_upgrade;
    proxy_set_header Connection        "upgrade";
    proxy_read_timeout 300s;

    # تقييد محاولات الدخول (fail2ban يلتقط 503 من هنا)
    location = /api/v1/auth/login {
        limit_req zone=login burst=5 nodelay;
        proxy_pass http://127.0.0.1:__API_PORT__;
    }

    location /api/ { proxy_pass http://127.0.0.1:__API_PORT__; }

    # WebSocket للتحديث الفوري
    location /socket.io/ { proxy_pass http://127.0.0.1:__API_PORT__; }

    location / { proxy_pass http://127.0.0.1:__WEB_PORT__; }
}
