# نسخة توضيحية فقط — الملف الحقيقي .env يُولَّد على الخادم بـ `task env` ولا يدخل git.
NODE_ENV=development
PUBLIC_URL=https://iat.sa
WEB_PORT=3000
API_PORT=3001

POSTGRES_USER=taskapp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=taskapp
DATABASE_URL=postgresql://taskapp:change-me@postgres:5432/taskapp?schema=public
REDIS_URL=redis://redis:6379

JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# كلمة مرور مستخدمي البذرة (seed) — بيئة التطوير فقط
SEED_PASSWORD=change-me
